# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Auth (JWT) — usa un secreto fuerte en producción
JWT_SECRET=your_jwt_secret_here

# La BD (DB_HOST/PORT/NAME/USER/PASSWORD) y la IA local (OLLAMA_HOST/OLLAMA_MODEL)
# las inyecta docker-compose. Fuera de Docker caen a localhost:3308 / :11434.

# Comprobación de actualizaciones (GitHub Releases). Opcional.
# GITHUB_REPO por defecto: susanaybenjamin-boop/construgest.
# Si el repo es PRIVADO, hace falta un token con permiso de lectura de releases
# para que el aviso de "nueva versión" funcione. Si el repo se hace público, no.
# GITHUB_REPO=susanaybenjamin-boop/construgest
# GITHUB_TOKEN=
